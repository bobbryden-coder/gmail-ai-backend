{
  "version": 2,
  "buildCommand": "npm install && npx prisma generate && npx prisma migrate deploy",
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api/index.js"
    }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/cron/check-trial-expiry?secret=595604000e497d76f2cf5c3027535620",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/send-nudge-emails?secret=595604000e497d76f2cf5c3027535620",
      "schedule": "0 9 * * *"
    }
  ]
}
